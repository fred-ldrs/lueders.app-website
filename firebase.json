      { "source": "/go/bison", "destination": "https://ldrs.uk/bison-bt", "type": 302 },
      { "source": "/go/bison/", "destination": "https://ldrs.uk/bison-bt", "type": 302 },
      { "source": "/go/bitvavo", "destination": "https://ldrs.uk/bitvavo-bt", "type": 302 },
      { "source": "/go/bitvavo/", "destination": "https://ldrs.uk/bitvavo-bt", "type": 302 },
      { "source": "/go/bitbox", "destination": "https://ldrs.uk/bitbox-bt", "type": 302 },
      { "source": "/go/bitbox/", "destination": "https://ldrs.uk/bitbox-bt", "type": 302 },
      { "source": "/go/jade", "destination": "https://ldrs.uk/jade-bt", "type": 302 },
      { "source": "/go/jade/", "destination": "https://ldrs.uk/jade-bt", "type": 302 },
      { "source": "/go/ledger", "destination": "https://ldrs.uk/ledger-bt", "type": 302 },
